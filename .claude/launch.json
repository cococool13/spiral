{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "collection",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "collection", "dev"],
      "port": 3000
    },
    {
      "name": "collection-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "collection/out", "-l", "3100"],
      "port": 3100
    },
    {
      "name": "wallpaper-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/wallpaper", "dev"],
      "port": 1420
    },
    {
      "name": "slim-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/slim/desktop", "dev"],
      "port": 1421
    }
  ]
}

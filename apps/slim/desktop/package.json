{
  "name": "spiral-slim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "sync-brand": "node ../../../scripts/sync-brand.mjs slim",
    "icon": "node scripts/make-icon.mjs",
    "predev": "node ../../../scripts/sync-brand.mjs slim",
    "prebuild": "node ../../../scripts/sync-brand.mjs slim",
    "dev": "vite",
    "build": "node ../../../scripts/check-hex.mjs slim && tsc && vite build",
    "check:hex": "node ../../../scripts/check-hex.mjs slim",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. The asset protocol may read $APPDATA/resume/cache/**.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://licensing.cohencool.workers.dev/buy/spiral"
        },
        {
          "url": "https://licensing.cohencool.workers.dev/resend"
        }
      ]
    }
  ]
}

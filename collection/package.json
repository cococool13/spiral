{
  "name": "spiral-collection-site",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-brand": "node ../scripts/sync-brand.mjs collection",
    "check:hex": "node ../scripts/check-hex.mjs collection",
    "predev": "node ../scripts/sync-brand.mjs collection",
    "prebuild": "node ../scripts/sync-brand.mjs collection",
    "dev": "next dev",
    "build": "pnpm check:hex && next build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  }
}
